NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: age for VO₂ reference in preparation index (default 38)
NEXT_PUBLIC_ATHLETE_AGE=38

# Vercel only. Lets Actualizar dispatch coaching-daily-collect.yml. Never on the Mac.
ACTIONS_DISPATCH_TOKEN=
ACTIONS_DISPATCH_REPO=dalarconics/python-garminconnect
ACTIONS_DISPATCH_REF=master

# Vercel only. Server-side coach chat. Never NEXT_PUBLIC_.
# Create at https://platform.openai.com/api-keys (restrict to this project if possible).
# Add in Vercel → Project → Settings → Environment Variables → Production (+ Preview optional).
# Redeploy after saving. Local dev: copy to apps/web/.env.local (gitignored).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional comma list to restrict/show models in the UI (default includes gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1)
OPENAI_MODELS=
